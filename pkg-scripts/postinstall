#!/bin/sh
set -e

PLIST="/Library/LaunchDaemons/com.skyglow.snd.plist"
DAEMON="/usr/local/libexec/skyglow/SkyglowNotificationsDaemon"

mkdir -p /usr/local/var/skyglow/var/log

if [ -f "$PLIST" ]; then
	chown root:wheel "$PLIST"
	chmod 644 "$PLIST"
fi
if [ -f "$DAEMON" ]; then
	chown root:wheel "$DAEMON"
	chmod 755 "$DAEMON"
fi

launchctl bootout system/com.skyglow.snd 2>/dev/null \
	|| launchctl unload "$PLIST" 2>/dev/null || true
launchctl bootstrap system "$PLIST" 2>/dev/null \
	|| launchctl load -w "$PLIST"

exit 0
