#!/bin/sh
set -e

echo "[Skyglow] Running removal script"

# Detect rootless
JB_PREFIX=""
if [ -d /var/jb ]; then
    JB_PREFIX="/var/jb"
fi

PLIST_PATH="$JB_PREFIX/Library/LaunchDaemons/com.skyglow.snd.plist"

echo "[SGN] Using prefix: ${JB_PREFIX:-/}"

if [ -f "$PLIST_PATH" ] && command -v launchctl >/dev/null 2>&1; then
    echo "[SGN] Unloading daemon with launchctl"
    launchctl unload "$PLIST_PATH" 2>/dev/null || true
fi

case "${1:-remove}" in
    remove|purge|failed-upgrade|disappear)
        rm -f "$PLIST_PATH"
        ;;
esac

echo "[SGN] Removal complete"
exit 0
