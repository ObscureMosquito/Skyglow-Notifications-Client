#!/bin/sh
set -e

echo "[SGN] Running post-install script"

if [ -d /var/mobile ]; then
    IS_IOS=1
    PREFIX=""
    [ -d /var/jb ] && PREFIX="/var/jb"
    PLIST_PATH="$PREFIX/Library/LaunchDaemons/com.skyglow.snd.plist"
    DAEMON_PATH="$PREFIX/usr/libexec/SkyglowNotificationsDaemon"
    STDERR_PATH="/var/mobile/Library/Logs/snd-err.log"
else
    IS_IOS=0
    PREFIX=""
    PLIST_PATH="/Library/LaunchDaemons/com.skyglow.snd.plist"
    DAEMON_PATH="/usr/local/libexec/SkyglowNotificationsDaemon"
    STDERR_PATH="/usr/local/var/skyglow/var/log/snd-err.log"
fi

echo "[SGN] Target: $([ "$IS_IOS" = 1 ] && echo iOS || echo macOS), prefix ${PREFIX:-/}"

if [ ! -f "$PLIST_PATH" ]; then
    echo "[SGN] ERROR: LaunchDaemon plist missing: $PLIST_PATH" >&2
    exit 1
fi
chown root:wheel "$PLIST_PATH"
chmod 644 "$PLIST_PATH"

mkdir -p "$(dirname "$STDERR_PATH")"
touch "$STDERR_PATH"
if [ "$IS_IOS" = 1 ]; then
    chown 501:501 "$STDERR_PATH" 2>/dev/null || chown mobile:mobile "$STDERR_PATH" 2>/dev/null || true
fi
chmod 644 "$STDERR_PATH"

if [ -f "$DAEMON_PATH" ]; then
    chown root:wheel "$DAEMON_PATH"
    chmod 755 "$DAEMON_PATH"
else
    echo "[SGN] ERROR: daemon binary not found at $DAEMON_PATH" >&2
    exit 1
fi

if command -v launchctl >/dev/null 2>&1; then
    echo "[SGN] Loading daemon with launchctl"
    launchctl unload "$PLIST_PATH" 2>/dev/null || true
    launchctl load "$PLIST_PATH"
fi

if [ "$IS_IOS" = 1 ]; then
    killall -9 Preferences 2>/dev/null || true
fi

echo "[SGN] Installation complete"
exit 0
