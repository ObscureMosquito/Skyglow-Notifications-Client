-include Makefile.macos.local

DAEMON_DIR := Skyglow-Notifications-Daemon
BUILD_ROOT := build/macos

SG_DAEMON_FILE_LOGGING ?= 1
SG_DAEMON_CONSOLE_LOGGING ?= 0
SG_DAEMON_TTY_LOGGING ?= 1

MACOS_CODESIGN_IDENTITY ?= -
MACOS_CODESIGN_IDENTIFIER ?= com.skyglow.snd.daemon
MACOS_CODESIGN_FLAGS ?=

MACOS_ARCH ?= $(shell uname -m)
ifeq ($(MACOS_ARCH),arm64)
DEFAULT_MACOSX_DEPLOYMENT_TARGET := 11.0
else ifeq ($(MACOS_ARCH),x86_64)
DEFAULT_MACOSX_DEPLOYMENT_TARGET := 10.8
else
$(error Unsupported MACOS_ARCH '$(MACOS_ARCH)'; use arm64 or x86_64)
endif
MACOSX_DEPLOYMENT_TARGET ?= $(DEFAULT_MACOSX_DEPLOYMENT_TARGET)
export MACOSX_DEPLOYMENT_TARGET

BUILD_DIR  := $(BUILD_ROOT)/$(MACOS_ARCH)
BIN        := $(BUILD_DIR)/SkyglowNotificationsDaemon

CC  := xcrun clang

# daemon
OBJC_SRCS := \
	$(DAEMON_DIR)/core/main.m \
	$(DAEMON_DIR)/core/SGNotificationProcessor.m \
	$(DAEMON_DIR)/shared/SGLog.m \
	$(DAEMON_DIR)/net/SGProtocolHandler.m \
	$(DAEMON_DIR)/net/SGServerLocator.m \
	$(DAEMON_DIR)/state/SGDatabaseManager.m \
	$(DAEMON_DIR)/crypto/SGCryptoEngine.m \
	$(DAEMON_DIR)/crypto/SGTokenManager.m \
	$(DAEMON_DIR)/payload/SGPayloadParser.m \
	$(DAEMON_DIR)/payload/SGJSONParser.m \
	$(DAEMON_DIR)/payload/SGStructuredTLV.m \
	$(DAEMON_DIR)/state/SGConfiguration.m \
	$(DAEMON_DIR)/state/SGKeychainStore.m \
	$(DAEMON_DIR)/net/SGKeepAliveOffload.m \
	$(DAEMON_DIR)/net/SGReachabilityMonitor.m \
	$(DAEMON_DIR)/core/SGDaemon.m \
	$(DAEMON_DIR)/platform/SGAvailability.m \
	$(DAEMON_DIR)/platform/SGPlatformFactory.m \
	$(DAEMON_DIR)/platform/SGMacPlatform.m \
	$(DAEMON_DIR)/state/SGAtomicFile.m \
	$(DAEMON_DIR)/state/SGDurableInbox.m \
	$(DAEMON_DIR)/state/SGStateStore.m \
	$(DAEMON_DIR)/state/SGMigration.m \
	$(DAEMON_DIR)/net/control/SGControlAuthorization.m \
	$(DAEMON_DIR)/net/control/SGControlChannel.m \
	$(DAEMON_DIR)/net/control/SGControlCommandRouter.m \
	$(DAEMON_DIR)/platform/SGCompatibilityShim.m

C_SRCS := \
	$(DAEMON_DIR)/core/SGConnectionPolicy.c \
	$(DAEMON_DIR)/shared/SGStatusServer.c \
	$(DAEMON_DIR)/net/SGKeepAliveStrategy.c \
	libraries/sqlite/sqlite3.c

OBJS := $(patsubst %,$(BUILD_DIR)/%.o,$(OBJC_SRCS) $(C_SRCS))

OPENSSL_PREFIX ?= $(shell brew --prefix openssl@3 2>/dev/null)
ifeq ($(OPENSSL_PREFIX),)
ifeq ($(filter uninstall clean status,$(MAKECMDGOALS)),)
$(error Could not locate OpenSSL. Install with 'brew install openssl@3' or pass OPENSSL_PREFIX=/path)
endif
endif
OPENSSL_INC := $(OPENSSL_PREFIX)/include
OPENSSL_LIB := $(OPENSSL_PREFIX)/lib

SQLITE_DEFS := \
	-DSQLITE_THREADSAFE=1 \
	-DSQLITE_OMIT_LOAD_EXTENSION \
	-DSQLITE_DEFAULT_MEMSTATUS=0 \
	-DSQLITE_ENABLE_LOCKING_STYLE=0 \
	-DHAVE_GETHOSTUUID=0

COMMON_FLAGS := \
	-arch $(MACOS_ARCH) \
	-mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET) \
	-fno-objc-arc \
	-fstack-protector-all -D_FORTIFY_SOURCE=2 \
	-I$(DAEMON_DIR)/core \
	-I$(DAEMON_DIR)/state \
	-I$(DAEMON_DIR)/net \
	-I$(DAEMON_DIR)/net/control \
	-I$(DAEMON_DIR)/crypto \
	-I$(DAEMON_DIR)/payload \
	-I$(DAEMON_DIR)/platform \
	-I$(DAEMON_DIR)/shared \
	-Ilibraries/sqlite/include \
	-I$(OPENSSL_INC) \
	-DSG_LOG_FILE_DEFAULT_ENABLED=$(SG_DAEMON_FILE_LOGGING) \
	-DSG_LOG_CONSOLE_DEFAULT_ENABLED=$(SG_DAEMON_CONSOLE_LOGGING) \
	-DSG_LOG_TTY_DEFAULT_ENABLED=$(SG_DAEMON_TTY_LOGGING) \
	-DOPENSSL_API_COMPAT=0x10100000L \
	$(SQLITE_DEFS) \
	-Wno-unused-result -Wno-unused-but-set-variable -Wno-deprecated-declarations \
	-O2 -g

OBJCFLAGS := $(COMMON_FLAGS)
CFLAGS_C  := $(COMMON_FLAGS)

FRAMEWORKS := \
	-framework Foundation \
	-framework CoreFoundation \
	-framework Security \
	-framework SystemConfiguration \
	-framework CFNetwork \
	-framework IOKit

LDFLAGS := \
	-arch $(MACOS_ARCH) \
	-mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET) \
	$(FRAMEWORKS) \
	$(OPENSSL_LIB)/libssl.a \
	$(OPENSSL_LIB)/libcrypto.a \
	-lz

.PHONY: all sign check-install-signing clean run dirs install uninstall reinstall status pkg
all: sign

$(BIN): $(OBJS)
	@mkdir -p $(@D)
	$(CC) $(OBJS) $(LDFLAGS) -o $@
	@echo "built $@"

sign: $(BIN)
	codesign --force --sign "$(MACOS_CODESIGN_IDENTITY)" \
		--identifier "$(MACOS_CODESIGN_IDENTIFIER)" \
		$(MACOS_CODESIGN_FLAGS) "$(BIN)"

check-install-signing: sign
	@if [ -z "$(MACOS_CODESIGN_IDENTITY)" ] || [ "$(MACOS_CODESIGN_IDENTITY)" = "-" ]; then \
		echo "[Skyglow] ERROR: refusing to install an ad-hoc-signed daemon."; \
		echo "[Skyglow] Its System-keychain access would break on the next rebuild."; \
		echo "[Skyglow] Create a persistent Code Signing certificate, then set:"; \
		echo "[Skyglow]   MACOS_CODESIGN_IDENTITY = <certificate name or SHA-1>"; \
		echo "[Skyglow] in Makefile.macos.local (or pass it to make)."; \
		exit 1; \
	fi
	@if codesign --display --verbose=2 "$(BIN)" 2>&1 | grep -q 'Signature=adhoc'; then \
		echo "[Skyglow] ERROR: the selected identity still produced an ad-hoc signature."; \
		exit 1; \
	fi
	@codesign --verify --strict "$(BIN)"

$(BUILD_DIR)/%.m.o: %.m
	@mkdir -p $(@D)
	$(CC) $(OBJCFLAGS) -c $< -o $@

$(BUILD_DIR)/%.c.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS_C) -c $< -o $@

run: sign
	sudo $(BIN)

clean:
	rm -rf $(BUILD_ROOT)

# sgnctl
SGNCTL_BIN  := $(BUILD_DIR)/sgnctl
SGNCTL_SRCS := \
	tools/sgnctl.m \
	$(DAEMON_DIR)/net/control/SGControlChannel.m \
	$(DAEMON_DIR)/net/control/SGControlAuthorization.m \
	$(DAEMON_DIR)/shared/SGLog.m

SGNCTL_CFLAGS := \
	-arch $(MACOS_ARCH) \
	-mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET) \
	-fno-objc-arc -O2 -g -Wno-deprecated-declarations \
	-I$(DAEMON_DIR)/net \
	-I$(DAEMON_DIR)/net/control \
	-I$(DAEMON_DIR)/shared \
	-I$(DAEMON_DIR)/platform \
	-I$(DAEMON_DIR)/core \
	-I$(DAEMON_DIR)/state

$(SGNCTL_BIN): $(SGNCTL_SRCS)
	@mkdir -p $(@D)
	$(CC) $(SGNCTL_CFLAGS) $(SGNCTL_SRCS) -framework Foundation -framework CoreFoundation -o $@
	@echo "built $@"

# install
LAUNCHD_LABEL    := com.skyglow.snd
LAUNCHD_PLIST    := /Library/LaunchDaemons/$(LAUNCHD_LABEL).plist
INSTALL_BIN      := /usr/local/libexec/skyglow/SkyglowNotificationsDaemon
INSTALL_CTL      := /usr/local/bin/sgnctl
LEGACY_INSTALL_BIN := /usr/local/bin/SkyglowNotificationsDaemon
MACOS_ROOT       := /usr/local/var/skyglow
KEYCHAIN_SERVICE := com.skyglow.daemon.privatekey
SYSTEM_KEYCHAIN  := /Library/Keychains/System.keychain

define SGN_LAUNCHD_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$(LAUNCHD_LABEL)</string>
	<key>ProgramArguments</key>
	<array>
		<string>$(INSTALL_BIN)</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
</dict>
</plist>
endef
export SGN_LAUNCHD_PLIST

install: check-install-signing
	@echo "[Skyglow] Installing daemon -> $(INSTALL_BIN)"
	sudo mkdir -p "$(dir $(INSTALL_BIN))" "$(MACOS_ROOT)/var/log"
	sudo cp "$(BIN)" "$(INSTALL_BIN)"
	sudo chown root:wheel "$(INSTALL_BIN)"
	sudo chmod 755 "$(INSTALL_BIN)"
	sudo rm -f "$(LEGACY_INSTALL_BIN)"
	@echo "[Skyglow] Writing $(LAUNCHD_PLIST)"
	@printf '%s\n' "$$SGN_LAUNCHD_PLIST" | sudo tee "$(LAUNCHD_PLIST)" > /dev/null
	sudo chown root:wheel "$(LAUNCHD_PLIST)"
	sudo chmod 644 "$(LAUNCHD_PLIST)"
	@echo "[Skyglow] (Re)loading via launchd"
	-sudo launchctl bootout system/$(LAUNCHD_LABEL) 2>/dev/null
	-sudo launchctl enable system/$(LAUNCHD_LABEL)
	sudo launchctl bootstrap system "$(LAUNCHD_PLIST)"
	@echo "[Skyglow] Installed and loaded. State: make -f Makefile.macos status"
	@echo "[Skyglow] Daemon log: $(MACOS_ROOT)/var/log/sgn.log"

uninstall:
	@echo "[Skyglow] Stopping and unloading launchd job"
	-sudo launchctl bootout system/$(LAUNCHD_LABEL) 2>/dev/null
	@echo "[Skyglow] Removing plist, binary, and runtime tree"
	-sudo rm -f "$(LAUNCHD_PLIST)"
	-sudo rm -f "$(INSTALL_BIN)"
	-sudo rm -f "$(LEGACY_INSTALL_BIN)"
	-sudo rm -rf "$(MACOS_ROOT)"
	@echo "[Skyglow] Clearing System-keychain private keys"
	@for i in 1 2 3 4 5; do \
		sudo security delete-generic-password -s "$(KEYCHAIN_SERVICE)" -a "profile$$i" "$(SYSTEM_KEYCHAIN)" >/dev/null 2>&1 || true; \
	done

reinstall: check-install-signing
	$(MAKE) -f Makefile.macos uninstall
	$(MAKE) -f Makefile.macos install

status:
	@echo "[Skyglow] launchd job:"
	@sudo launchctl print system/$(LAUNCHD_LABEL) 2>/dev/null | grep -E '^\s*(state|pid|runs|last exit code) =' || echo "  (not loaded)"
	@echo "[Skyglow] $(MACOS_ROOT)/var/log/sgn.log (last 20 lines):"
	@sudo tail -n 20 "$(MACOS_ROOT)/var/log/sgn.log" 2>/dev/null || echo "  (no log yet)"

# pkg
PKG_VERSION ?= 1.0
PKG_DIR     := $(BUILD_DIR)/pkg
PKG_ROOT    := $(PKG_DIR)/root
PKG_SCRIPTS := $(PKG_DIR)/scripts
PKG_OUTPUT  := $(BUILD_DIR)/SkyglowNotificationsDaemon-$(MACOS_ARCH)-$(PKG_VERSION).pkg

pkg: $(BIN) $(SGNCTL_BIN)
	@if [ "$(MACOS_CODESIGN_IDENTITY)" != "-" ] && [ -n "$(MACOS_CODESIGN_IDENTITY)" ]; then \
		echo "[Skyglow] Signing with $(MACOS_CODESIGN_IDENTITY)"; \
		codesign --force --sign "$(MACOS_CODESIGN_IDENTITY)" \
			--identifier "$(MACOS_CODESIGN_IDENTIFIER)" \
			$(MACOS_CODESIGN_FLAGS) "$(BIN)"; \
	else \
		echo "[Skyglow] No signing identity, building unsigned pkg"; \
	fi
	@echo "[Skyglow] Staging pkg layout"
	rm -rf "$(PKG_DIR)"
	mkdir -p "$(PKG_ROOT)$(dir $(INSTALL_BIN))"
	mkdir -p "$(PKG_ROOT)$(dir $(INSTALL_CTL))"
	mkdir -p "$(PKG_ROOT)$(dir $(LAUNCHD_PLIST))"
	mkdir -p "$(PKG_ROOT)$(MACOS_ROOT)/var/log"
	cp "$(BIN)" "$(PKG_ROOT)$(INSTALL_BIN)"
	chmod 755 "$(PKG_ROOT)$(INSTALL_BIN)"
	cp "$(SGNCTL_BIN)" "$(PKG_ROOT)$(INSTALL_CTL)"
	chmod 755 "$(PKG_ROOT)$(INSTALL_CTL)"
	printf '%s\n' "$$SGN_LAUNCHD_PLIST" > "$(PKG_ROOT)$(LAUNCHD_PLIST)"
	chmod 644 "$(PKG_ROOT)$(LAUNCHD_PLIST)"
	mkdir -p "$(PKG_SCRIPTS)"
	printf '%s\n' '#!/bin/sh' \
		'/bin/launchctl bootout system/$(LAUNCHD_LABEL) 2>/dev/null ||' \
		'  /bin/launchctl unload "$(LAUNCHD_PLIST)" 2>/dev/null || true' \
		'rm -f "$(LEGACY_INSTALL_BIN)"' \
		'exit 0' > "$(PKG_SCRIPTS)/preinstall"
	chmod 755 "$(PKG_SCRIPTS)/preinstall"
	printf '%s\n' '#!/bin/sh' \
		'mkdir -p "$(MACOS_ROOT)/var/log"' \
		'/bin/launchctl bootstrap system "$(LAUNCHD_PLIST)" 2>/dev/null ||' \
		'  /bin/launchctl load -w "$(LAUNCHD_PLIST)"' \
		'exit 0' > "$(PKG_SCRIPTS)/postinstall"
	chmod 755 "$(PKG_SCRIPTS)/postinstall"
	@echo "[Skyglow] Building $(PKG_OUTPUT)"
	pkgbuild \
		--root "$(PKG_ROOT)" \
		--scripts "$(PKG_SCRIPTS)" \
		--identifier "$(LAUNCHD_LABEL)" \
		--version "$(PKG_VERSION)" \
		--ownership recommended \
		"$(PKG_OUTPUT)"
	@echo "[Skyglow] Package ready: $(PKG_OUTPUT)"
