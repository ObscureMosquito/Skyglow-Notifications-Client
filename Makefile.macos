# Standalone macOS build for the Skyglow Notifications daemon core.
#   make -f Makefile.macos            # build build/macos/SkyglowNotificationsDaemon
#   make -f Makefile.macos run        # build + run (needs sudo for /var paths)
#   make -f Makefile.macos clean

DAEMON_DIR := Skyglow-Notifications-Daemon
BUILD_DIR  := build/macos
BIN        := $(BUILD_DIR)/SkyglowNotificationsDaemon

CC  := xcrun clang
OBJC_SRCS := \
	$(DAEMON_DIR)/core/main.m \
	$(DAEMON_DIR)/shared/SGLog.m \
	$(DAEMON_DIR)/net/SGProtocolHandler.m \
	$(DAEMON_DIR)/net/SGServerLocator.m \
	$(DAEMON_DIR)/state/SGDatabaseManager.m \
	$(DAEMON_DIR)/crypto/SGCryptoEngine.m \
	$(DAEMON_DIR)/crypto/SGTokenManager.m \
	$(DAEMON_DIR)/payload/SGPayloadParser.m \
	$(DAEMON_DIR)/payload/SGJSONParser.m \
	$(DAEMON_DIR)/payload/SGStructuredTLV.m \
	$(DAEMON_DIR)/state/SGConfiguration.m \
	$(DAEMON_DIR)/state/SGKeychainStore.m \
	$(DAEMON_DIR)/net/SGKeepAliveOffload.m \
	$(DAEMON_DIR)/net/SGReachabilityMonitor.m \
	$(DAEMON_DIR)/core/SGDaemon.m \
	$(DAEMON_DIR)/platform/SGAvailability.m \
	$(DAEMON_DIR)/platform/SGNotificationSenderMac.m \
	$(DAEMON_DIR)/state/SGAtomicFile.m \
	$(DAEMON_DIR)/state/SGDurableInbox.m \
	$(DAEMON_DIR)/state/SGStateStore.m \
	$(DAEMON_DIR)/state/SGMigration.m \
	$(DAEMON_DIR)/net/SGControlAuthorization.m \
	$(DAEMON_DIR)/net/SGControlChannel.m \
	$(DAEMON_DIR)/platform/SGCompatibilityShim.m

C_SRCS := \
	$(DAEMON_DIR)/shared/SGStatusServer.c \
	$(DAEMON_DIR)/net/SGKeepAliveStrategy.c \
	libraries/sqlite/sqlite3.c

OBJS := $(patsubst %,$(BUILD_DIR)/%.o,$(OBJC_SRCS) $(C_SRCS))

OPENSSL_PREFIX ?= $(shell brew --prefix openssl@3 2>/dev/null)
ifeq ($(OPENSSL_PREFIX),)
ifeq ($(filter install uninstall clean,$(MAKECMDGOALS)),)
$(error Could not locate OpenSSL. Install with 'brew install openssl@3' or pass OPENSSL_PREFIX=/path)
endif
endif
OPENSSL_INC := $(OPENSSL_PREFIX)/include
OPENSSL_LIB := $(OPENSSL_PREFIX)/lib

# --- Flags ----------------------------------------------------------------
SQLITE_DEFS := \
	-DSQLITE_THREADSAFE=1 \
	-DSQLITE_OMIT_LOAD_EXTENSION \
	-DSQLITE_DEFAULT_MEMSTATUS=0 \
	-DSQLITE_ENABLE_LOCKING_STYLE=0 \
	-DHAVE_GETHOSTUUID=0

COMMON_FLAGS := \
	-arch $(shell uname -m) \
	-fno-objc-arc \
	-fstack-protector-all -D_FORTIFY_SOURCE=2 \
	-I$(DAEMON_DIR)/core \
	-I$(DAEMON_DIR)/state \
	-I$(DAEMON_DIR)/net \
	-I$(DAEMON_DIR)/crypto \
	-I$(DAEMON_DIR)/payload \
	-I$(DAEMON_DIR)/platform \
	-I$(DAEMON_DIR)/shared \
	-Ilibraries/sqlite/include \
	-I$(OPENSSL_INC) \
	-DOPENSSL_API_COMPAT=0x10100000L \
	$(SQLITE_DEFS) \
	-Wno-unused-result -Wno-unused-but-set-variable -Wno-deprecated-declarations \
	-O2 -g

OBJCFLAGS := $(COMMON_FLAGS)
CFLAGS_C  := $(COMMON_FLAGS)

FRAMEWORKS := \
	-framework Foundation \
	-framework CoreFoundation \
	-framework Security \
	-framework SystemConfiguration \
	-framework CFNetwork \
	-framework IOKit

LDFLAGS := \
	$(FRAMEWORKS) \
	$(OPENSSL_LIB)/libssl.a \
	$(OPENSSL_LIB)/libcrypto.a \
	-lz

# --- Rules ----------------------------------------------------------------
.PHONY: all clean run dirs install uninstall reinstall status
all: $(BIN)

$(BIN): $(OBJS)
	@mkdir -p $(@D)
	$(CC) $(OBJS) $(LDFLAGS) -o $@
	@echo "built $@"
	@codesign -s - --entitlements /dev/null $@ 2>/dev/null || true

$(BUILD_DIR)/%.m.o: %.m
	@mkdir -p $(@D)
	$(CC) $(OBJCFLAGS) -c $< -o $@

$(BUILD_DIR)/%.c.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS_C) -c $< -o $@

run: $(BIN)
	sudo $(BIN)

clean:
	rm -rf $(BUILD_DIR)

# --- Install as a launchd daemon (root) -----------------------------------
LAUNCHD_LABEL    := com.skyglow.snd
LAUNCHD_PLIST    := /Library/LaunchDaemons/$(LAUNCHD_LABEL).plist
INSTALL_BIN      := /usr/local/bin/SkyglowNotificationsDaemon
MACOS_ROOT       := /usr/local/var/skyglow
STDERR_LOG       := $(MACOS_ROOT)/var/log/snd-err.log
KEYCHAIN_SERVICE := com.skyglow.daemon.privatekey
SYSTEM_KEYCHAIN  := /Library/Keychains/System.keychain

define SGN_LAUNCHD_PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$(LAUNCHD_LABEL)</string>
	<key>ProgramArguments</key>
	<array>
		<string>$(INSTALL_BIN)</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>$(STDERR_LOG)</string>
</dict>
</plist>
endef
export SGN_LAUNCHD_PLIST

install:
	@test -f "$(BIN)" || { echo "No build at $(BIN) — run 'make -f Makefile.macos' first (as your user)."; exit 1; }
	@echo "[Skyglow] Installing daemon -> $(INSTALL_BIN)"
	sudo mkdir -p "$(dir $(INSTALL_BIN))" "$(MACOS_ROOT)/var/log"
	sudo cp "$(BIN)" "$(INSTALL_BIN)"
	sudo chown root:wheel "$(INSTALL_BIN)"
	sudo chmod 755 "$(INSTALL_BIN)"
	@echo "[Skyglow] Writing $(LAUNCHD_PLIST)"
	@printf '%s\n' "$$SGN_LAUNCHD_PLIST" | sudo tee "$(LAUNCHD_PLIST)" > /dev/null
	sudo chown root:wheel "$(LAUNCHD_PLIST)"
	sudo chmod 644 "$(LAUNCHD_PLIST)"
	@echo "[Skyglow] (Re)loading via launchd"
	@# bootout first so a re-run replaces the running job instead of hitting
	@# 'Bootstrap failed: 5: Input/output error' (launchd's message for a label
	@# that is already registered). The '-' ignores the not-loaded case.
	-sudo launchctl bootout system/$(LAUNCHD_LABEL) 2>/dev/null
	-sudo launchctl enable system/$(LAUNCHD_LABEL)
	sudo launchctl bootstrap system "$(LAUNCHD_PLIST)"
	@echo "[Skyglow] Installed and loaded. State: make -f Makefile.macos status"
	@echo "[Skyglow] Daemon log: $(MACOS_ROOT)/var/log/sgn.log  (launchd stderr: $(STDERR_LOG))"

uninstall:
	@echo "[Skyglow] Stopping and unloading launchd job"
	-sudo launchctl bootout system/$(LAUNCHD_LABEL) 2>/dev/null
	@echo "[Skyglow] Removing plist, binary, and runtime tree"
	-sudo rm -f "$(LAUNCHD_PLIST)"
	-sudo rm -f "$(INSTALL_BIN)"
	-sudo rm -rf "$(MACOS_ROOT)"
	@echo "[Skyglow] Clearing System-keychain private keys"
	@for i in 1 2 3 4 5; do \
		sudo security delete-generic-password -s "$(KEYCHAIN_SERVICE)" -a "profile$$i" "$(SYSTEM_KEYCHAIN)" >/dev/null 2>&1 || true; \
	done
	@echo "[Skyglow] Uninstalled — no files, launchd job, or keychain items left behind."

reinstall: uninstall all install

status:
	@echo "[Skyglow] launchd job:"
	@sudo launchctl print system/$(LAUNCHD_LABEL) 2>/dev/null | grep -E '^\s*(state|pid|runs|last exit code) =' || echo "  (not loaded)"
	@echo "[Skyglow] $(MACOS_ROOT)/var/log/sgn.log (last 20 lines):"
	@sudo tail -n 20 "$(MACOS_ROOT)/var/log/sgn.log" 2>/dev/null || echo "  (no log yet)"
